{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["ingress"],
  "properties": {
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["serviceName", "hostname", "ingressClassName"],
      "properties": {
        "serviceName": {"type": "string", "minLength": 1, "maxLength": 63, "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"},
        "hostname": {"type": "string", "minLength": 1, "maxLength": 253, "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"},
        "ingressClassName": {"type": "string", "minLength": 1},
        "tlsSecretName": {"type": "string"},
        "annotations": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    }
  }
}
